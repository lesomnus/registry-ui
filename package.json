{
  "name": "registry-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A browser for any OCI registry",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "serve": "bun run server/main.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@lesomnus/oci-client": "github:lesomnus/oci-client"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
